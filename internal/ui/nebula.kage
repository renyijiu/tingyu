package main

// The sky behind the window: clouds of gas folded through each other
// (domain-warped fractal noise), lit by the show's color and the aurora's
// violet and cyan, darker toward the edges. It is drawn small and
// stretched, since nothing in it is sharp.

// Time is how far the clouds have drifted, in seconds of playback.
var Time float

// Energy brightens and stirs the clouds while something plays, 0 to 1.
var Energy float

// Base is the sky, Tint the show's color, Violet and Cyan the aurora's.
var Base vec4
var Tint vec4
var Violet vec4
var Cyan vec4

// Light is 1 in the light theme, where the clouds are a pale wash.
var Light float

func hash(p vec2) float {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453)
}

func noise(p vec2) float {
	i := floor(p)
	f := fract(p)
	u := f * f * (3 - 2*f)
	a := hash(i)
	b := hash(i + vec2(1, 0))
	c := hash(i + vec2(0, 1))
	d := hash(i + vec2(1, 1))
	return mix(mix(a, b, u.x), mix(c, d, u.x), u.y)
}

func fbm(p vec2) float {
	v := 0.0
	a := 0.5
	for i := 0; i < 5; i++ {
		v += a * noise(p)
		p = p*2.03 + vec2(1.7, 9.2)
		a *= 0.5
	}
	return v
}

func Fragment(dst vec4, pos vec2) vec4 {
	size := rectSize()
	uv := pos / size.y
	t := Time * (0.035 + 0.02*Energy)

	q := vec2(fbm(uv*1.5+vec2(0, t)), fbm(uv*1.5+vec2(5.2, 1.3)-vec2(t, 0)))
	r := vec2(fbm(uv*1.5+3.2*q+vec2(1.7, 9.2)+0.6*t), fbm(uv*1.5+3.2*q+vec2(8.3, 2.8)-0.4*t))
	n := fbm(uv*1.5 + 3.6*r)

	// Light pools toward the top right and the bottom left, as if the
	// window looked into a galaxy's arm.
	frame := pos / size
	glow := 0.55*exp(-3.2*dot(frame-vec2(0.82, 0.12), frame-vec2(0.82, 0.12))) +
		0.4*exp(-4.5*dot(frame-vec2(0.15, 0.95), frame-vec2(0.15, 0.95)))

	strength := (0.55 + 0.25*Energy) * (0.45 + 0.9*glow)
	if Light > 0.5 {
		strength *= 0.55
	}

	col := Base.rgb
	col = mix(col, Violet.rgb, clamp(smoothstep(0.3, 0.95, n)*strength, 0, 1))
	col = mix(col, Tint.rgb, clamp(smoothstep(0.35, 1.05, length(q))*strength*1.1, 0, 1))
	col = mix(col, Cyan.rgb, clamp(smoothstep(0.55, 1.05, r.x)*strength*0.6, 0, 1))
	// Bright filaments where the folds meet.
	fil := smoothstep(0.62, 0.9, n*r.y*1.6)
	col += mix(Tint.rgb, vec3(1), 0.4) * fil * 0.18 * strength

	// Edges fall into the dark (or the light).
	v := frame - 0.5
	vig := smoothstep(0.95, 0.2, length(v*vec2(0.9, 1.1)))
	col = mix(Base.rgb, col, 0.35+0.65*vig)
	return vec4(clamp(col, 0, 1), 1)
}
